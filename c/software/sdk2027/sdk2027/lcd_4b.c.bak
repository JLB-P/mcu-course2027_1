
//#define F_CPU 16000000UL //arduino freq.
#include <avr/io.h>
#include <util/delay.h>
#include "LCD_4b.h"

char FirstColumn [2] = {0 , 64};	//first column address

void lcd_reset(void)
{
	lcd_port = 0xFF; //wait for 15 ms
	_delay_ms(20);
	
	lcd_port = 0x30+LCD_EN; //write Rs=0|RW=0|DB7=0|DB6=0|DB5=1|DB4=1 y E=1
	lcd_port = 0x30;		//write Rs=0|RW=0|DB7=0|DB6=0|DB5=1|DB4=1 y E=0
	_delay_ms(10);			//wait for 4.1 ms
	
	lcd_port = 0x30+LCD_EN; //write Rs=0|RW=0|DB7=0|DB6=0|DB5=1|DB4=1 y E=1
	lcd_port = 0x30;		//write Rs=0|RW=0|DB7=0|DB6=0|DB5=1|DB4=1 y E=0
	_delay_ms(1);			//wait for 100 us
	
	lcd_port = 0x30+LCD_EN; //write Rs=0|RW=0|DB7=0|DB6=0|DB5=1|DB4=1 y E=1
	lcd_port = 0x30;		//write Rs=0|RW=0|DB7=0|DB6=0|DB5=1|DB4=1 y E=0
	_delay_ms(1);			//wait for 100 us
	
	lcd_port = 0x20+LCD_EN; //write Rs=0|RW=0|DB7=0|DB6=0|DB5=1|DB4=0 y E=1
	lcd_port = 0x20;		//write Rs=0|RW=0|DB7=0|DB6=0|DB5=1|DB4=0 y E=0
	_delay_ms(1);			//wait for 100 us
}

void lcd_cmd (char cmd)
{
	lcd_port = (cmd & 0xF0)|LCD_EN;
	lcd_port = (cmd & 0xF0);
	lcd_port = ((cmd << 4) & 0xF0)|LCD_EN;
	lcd_port = ((cmd << 4) & 0xF0);
	_delay_ms(2);
	_delay_ms(2);
}

//Initialize LCD
void lcd_init (void)
{
	lcd_reset();        // Reset LCD
	
	lcd_cmd(0x2C);		// set: Mode 4 bits, 2 lines, resolution 5×10
	lcd_cmd(0x0C);      // display control: LCD on, cursor on, blinking
	lcd_cmd(0x06);      // entry mode: Increment
	lcd_cmd(0x80);      // point to DDRAM.
}


/********************************************************
*	Función que despliega un solo caracter
*	Entrada: caracter entre comillas sencillas (p.e. 'A')
*	Salida: Ninguna
*********************************************************/
void lcd_data (unsigned char dat)
{
	lcd_port = ((dat & 0xF0)|LCD_EN|LCD_RS);
	lcd_port = ((dat & 0xF0)|LCD_RS);
	lcd_port = (((dat << 4) & 0xF0)|LCD_EN|LCD_RS);
	lcd_port = (((dat << 4) & 0xF0)|LCD_RS);
	_delay_ms(2);
	_delay_ms(2);
}


/********************************************************
*	Posiciona el cursor en Columna y Renglón
*	Entrada: Columna y Renglón (1,1)
*	Salida: Ninguna
*********************************************************/
void lcd_col_row(uint8_t x, uint8_t y)
{
	lcd_cmd(0x80 + FirstColumn[y-1]+(x-1));
}


/********************************************************
*	Limpia la pantalla
*	Entrada: Nada
*	Salida: Nada
*********************************************************/
void lcd_clr(void)
{
	lcd_cmd(0x01); //Limpia la pantalla (0000 0001)
	_delay_ms(2);
}


/********************************************************
*	Despliega una cadena de caracteres
*	Entrada: Cadena de caracteres entre comillas (p.e. "Hola LCD..")
*	Salida: Ninguna
*********************************************************/
void lcd_write_string(char *a)
{
	unsigned int i;
	for(i=0;a[i]!=0;i++)
	lcd_data(a[i]);
}
